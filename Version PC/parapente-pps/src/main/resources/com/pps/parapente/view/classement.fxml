<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.pps.parapente.controller.ClassementController" prefWidth="1050" prefHeight="680">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="bandeau">
            <Button text="&#8592; Retour" styleClass="bouton-secondaire" onAction="#retour"/>
            <Label text="Classements" style="-fx-font-size:18px; -fx-font-weight:bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Actualiser" styleClass="bouton-principal" onAction="#actualiser"/>
        </HBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Classement général">
                <BorderPane>
                    <center>
                        <TableView fx:id="tableClassement" BorderPane.alignment="CENTER"/>
                    </center>
                    <bottom>
                        <Label text="Une case décochée « Afficher le classement » masque le détail d'une épreuve ici (la colonne disparaît) mais celle-ci peut toujours compter dans le total si « compte dans le général » est coché."
                               wrapText="true" style="-fx-text-fill:#7f8c8d; -fx-font-size:11px;">
                            <padding><Insets top="6" right="16" bottom="10" left="16"/></padding>
                        </Label>
                    </bottom>
                </BorderPane>
            </Tab>
            <Tab text="Détail par épreuve">
                <BorderPane>
                    <top>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <padding><Insets top="14" right="16" bottom="10" left="16"/></padding>
                            <Label text="Épreuve :"/>
                            <ComboBox fx:id="comboEpreuveDetail" prefWidth="280"/>
                            <Label text="(seules les épreuves avec « Afficher le classement » coché apparaissent ici)"
                                   style="-fx-text-fill:#7f8c8d; -fx-font-size:11px;" wrapText="true"/>
                        </HBox>
                    </top>
                    <center>
                        <TableView fx:id="tableDetailEpreuve" BorderPane.alignment="CENTER">
                            <columns>
                                <TableColumn fx:id="colDetailRang" text="Rang" prefWidth="60"/>
                                <TableColumn fx:id="colDetailPilote" text="Pilote" prefWidth="180"/>
                                <TableColumn fx:id="colDetailCaserne" text="Caserne" prefWidth="150"/>
                                <TableColumn fx:id="colDetailValeurs" text="Valeurs saisies" prefWidth="220"/>
                                <TableColumn fx:id="colDetailPoints" text="Points" prefWidth="80"/>
                                <TableColumn fx:id="colDetailDisqualifie" text="Disqualifié" prefWidth="90"/>
                            </columns>
                        </TableView>
                    </center>
                </BorderPane>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
