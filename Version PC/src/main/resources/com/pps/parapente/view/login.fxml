<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.pps.parapente.controller.LoginController" prefWidth="900" prefHeight="600">
    <VBox alignment="CENTER" spacing="18" maxWidth="380">
        <Label text="Championnat de France Pompiers de Parapente" wrapText="true" alignment="CENTER"
               textAlignment="CENTER" styleClass="titre"/>
        <Label text="Parapente Pays de Sault - Été 2027" style="-fx-text-fill: #7f8c8d;"/>

        <VBox spacing="10" styleClass="carte-menu" maxWidth="340">
            <Label text="Identifiant" styleClass="champ-formulaire"/>
            <TextField fx:id="champIdentifiant" promptText="ex: admin"/>

            <Label text="Mot de passe" styleClass="champ-formulaire"/>
            <PasswordField fx:id="champMotDePasse" promptText="********" onAction="#seConnecter"/>

            <Label fx:id="labelErreur" styleClass="erreur" wrapText="true" managed="false" visible="false"/>

            <Button text="Se connecter" styleClass="bouton-principal" maxWidth="Infinity" onAction="#seConnecter"/>
            <Label text="Compte par défaut : admin / admin123" style="-fx-text-fill:#95a5a6; -fx-font-size:11px;"/>
        </VBox>
    </VBox>
</StackPane>
