<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.pps.parapente.controller.GestionUtilisateursController" prefWidth="900" prefHeight="620">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="bandeau">
            <Button text="&#8592; Retour" styleClass="bouton-secondaire" onAction="#retour"/>
            <Label text="Gestion des comptes" style="-fx-font-size:18px; -fx-font-weight:bold;"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="tableUtilisateurs" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colIdentifiant" text="Identifiant" prefWidth="180"/>
                <TableColumn fx:id="colRole" text="Rôle" prefWidth="220"/>
                <TableColumn fx:id="colActif" text="Actif" prefWidth="80"/>
            </columns>
        </TableView>
    </center>
    <right>
        <VBox spacing="8" prefWidth="280" styleClass="carte-menu">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <Label text="Nouveau compte" styleClass="sous-titre"/>

            <Label text="Identifiant *"/>
            <TextField fx:id="champIdentifiant"/>
            <Label text="Mot de passe *"/>
            <PasswordField fx:id="champMotDePasse"/>
            <Label text="Rôle *"/>
            <ComboBox fx:id="champRole" maxWidth="Infinity"/>

            <Label fx:id="labelErreur" styleClass="erreur" wrapText="true" managed="false" visible="false"/>

            <Button text="Créer le compte" styleClass="bouton-principal" onAction="#creerCompte"/>
            <Button text="Supprimer le compte sélectionné" styleClass="bouton-danger" onAction="#supprimerCompte"/>
        </VBox>
    </right>
</BorderPane>
