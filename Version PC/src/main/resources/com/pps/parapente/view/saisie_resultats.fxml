<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.pps.parapente.controller.SaisieResultatsController" prefWidth="1050" prefHeight="680">
    <top>
        <VBox styleClass="bandeau" spacing="10">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button text="&#8592; Retour" styleClass="bouton-secondaire" onAction="#retour"/>
                <Label text="Saisie des résultats" style="-fx-font-size:18px; -fx-font-weight:bold;"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Épreuve :" style="-fx-text-fill:white;"/>
                <ComboBox fx:id="comboEpreuve" prefWidth="280"/>
                <Label text="Pilote :" style="-fx-text-fill:white;"/>
                <ComboBox fx:id="comboPilote" prefWidth="220"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.42">
            <VBox spacing="10" styleClass="carte-menu">
                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                <Label text="Saisie de la performance" styleClass="sous-titre"/>
                <VBox fx:id="conteneurChampsDynamiques" spacing="8"/>
                <CheckBox fx:id="checkDisqualifie" text="Disqualifié / problème de sécurité (0 point automatique)"/>
                <Label fx:id="labelErreur" styleClass="erreur" wrapText="true" managed="false" visible="false"/>
                <Button text="Enregistrer le résultat" styleClass="bouton-principal" onAction="#enregistrerResultat"/>
                <Label fx:id="labelInfo" wrapText="true" style="-fx-text-fill:#27ae60; -fx-font-weight:bold;" managed="false" visible="false"/>
            </VBox>
            <VBox spacing="8">
                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                <Label text="Résultats déjà saisis pour cette épreuve" styleClass="sous-titre"/>
                <TableView fx:id="tableResultats" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colPiloteNom" text="Pilote" prefWidth="160"/>
                        <TableColumn fx:id="colValeurs" text="Valeurs saisies" prefWidth="220"/>
                        <TableColumn fx:id="colPoints" text="Points" prefWidth="80"/>
                        <TableColumn fx:id="colDisqualifie" text="Disqualifié" prefWidth="80"/>
                    </columns>
                </TableView>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
